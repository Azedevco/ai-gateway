# Address to listen on. Keep it private (127.0.0.1, a LAN or VPN address); the admin UI and
# the API are meant for an internal network.
GATEWAY_BIND=127.0.0.1:8090

# SQLite database file. The directory is created on start.
DATABASE_URL=sqlite://data/gateway.db

# Admin UI password (8+ characters).
ADMIN_PASSWORD=change-me-please

# Signs the admin session cookie. 64+ characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-64-or-more-random-characters-replace-with-64-or-more-random

# Set to 1 when the admin UI is served over HTTPS.
SECURE_COOKIES=0

# Delete request logs older than this many days (0 keeps everything).
RETENTION_DAYS=90

# Log level: error, warn, info, debug.
RUST_LOG=info,sqlx=warn
